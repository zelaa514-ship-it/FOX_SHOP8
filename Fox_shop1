		end

	end)

end)

-- =========================
-- فحص Drop
-- =========================

local function checkDrop(object, data)

	if not object or not object.Parent then

		candidates[object] = nil

		return false

	end

	if isPlayerObject(object) then

		candidates[object] = nil

		return false

	end

	if isVehicleOrAircraft(object) then

		candidates[object] = nil

		return false

	end

	if isLargeObject(object) then

		candidates[object] = nil

		return false

	end

	local root = getRoot()

	if not root then
		return false
	end

	local now = os.clock()

	local currentPosition = object.Position

	local dt = now - data.lastTime

	if dt <= 0 then
		return false
	end

	local verticalSpeed =
		(currentPosition.Y - data.lastPosition.Y) / dt

	data.samples += 1

	if currentPosition.Y > data.highestY then
		data.highestY = currentPosition.Y
	end

	local falling =
		verticalSpeed < -MIN_FALL_SPEED

	if falling then
		data.fallSamples += 1
	end

	local startedHigh =
		data.highestY >= root.Position.Y + MIN_HEIGHT

	local horizontalDistance = (
		Vector3.new(currentPosition.X, 0, currentPosition.Z)
		-
		Vector3.new(root.Position.X, 0, root.Position.Z)
	).Magnitude

	local inRange =
		horizontalDistance <= SCAN_DISTANCE

	local stableSpeed = true

	if data.lastFallSpeed then

		local difference =
			math.abs(
				math.abs(verticalSpeed)
				-
				data.lastFallSpeed
			)

		if difference > SPEED_TOLERANCE then
			stableSpeed = false
		end

	end

	if falling then
		data.lastFallSpeed = math.abs(verticalSpeed)
	end

	data.lastPosition = currentPosition
	data.lastTime = now

	if
		data.samples >= MIN_SAMPLES
		and data.fallSamples >= 3
		and falling
		and startedHigh
		and inRange
		and stableSpeed
		and data.lastFallSpeed
		and data.lastFallSpeed >= MIN_FALL_SPEED
	then

		return true

	end

	return false

end

-- =========================
-- العثور على ProximityPrompt
-- =========================

local function findDropPrompt(drop)

	if not drop or not drop.Parent then
		return nil
	end

	local prompt = drop:FindFirstChildWhichIsA("ProximityPrompt", true)

	if prompt and prompt.Enabled then
		return prompt
	end

	local model = drop:FindFirstAncestorOfClass("Model")

	if model then

		prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)

		if prompt and prompt.Enabled then
			return prompt
		end

	end

	return nil

end

-- =========================
-- تفعيل الـPrompt لمدة ثانيتين
-- =========================

local function holdDropPrompt(drop)

	local prompt = findDropPrompt(drop)

	if not prompt then

		status.Text = "⚠️ لم يتم العثور على التفاعل"

		return false

	end

	status.Text = "✋ التقاط الـDrop..."

	local holdTime = math.max(
		PROMPT_HOLD_TIME,
		prompt.HoldDuration
	)

	local successBegin = pcall(function()
		prompt:InputHoldBegin()
	end)

	if not successBegin then

		status.Text = "⚠️ تعذر بدء التفاعل"

		return false

	end

	task.wait(holdTime)

	pcall(function()
		prompt:InputHoldEnd()
	end)

	task.wait(0.25)

	return true

end

-- =========================
-- البحث عن واجهة المعادلة
-- =========================

local function findEquationInterface()

	for _, screenGui in ipairs(playerGui:GetChildren()) do

		if screenGui:IsA("ScreenGui") and screenGui.Enabled then

			for _, object in ipairs(screenGui:GetDescendants()) do

				if object:IsA("TextLabel") then

					local text = object.Text

					-- يقبل مثل:
					-- 3 + 2 = ?
					-- 10 + 6 = ?
					local a, b = string.match(
						text,
						"^%s*(%d+)%s*%+%s*(%d+)%s*=%s*%?%s*$"
					)

					if a and b then

						local answerBox = nil
						local confirmButton = nil

						-- نبحث داخل أقرب Frame للمعادلة
						local container = object.Parent

						while container
							and container ~= screenGui
							and not container:IsA("Frame") do

							container = container.Parent

						end

						if not container then
							container = object.Parent
						end

						for _, child in ipairs(container:GetDescendants()) do

							if child:IsA("TextBox") then

								answerBox = child

							elseif child:IsA("TextButton") then

								local buttonText =
									string.lower(child.Text)

								if string.find(
									buttonText,
									"تأكيد",
									1,
									true
								)
								or string.find(
									buttonText,
									"confirm",
									1,
									true
								) then

									confirmButton = child

								end

							end

						end

						if answerBox and confirmButton then

							return {
								label = object,
								answerBox = answerBox,
								confirmButton = confirmButton,
								a = tonumber(a),
								b = tonumber(b)
							}

						end

					end

				end

			end

		end

	end

	return nil

end

-- =========================
-- حل المعادلة
-- =========================

local function solveEquation()

	status.Text = "🧩 البحث عن المعادلة..."

	local startTime = os.clock()

	while enabled
		and os.clock() - startTime < EQUATION_TIMEOUT do

		local equation = findEquationInterface()

		if equation then

			local answer =
				equation.a + equation.b

			status.Text =
				"🧮 الإجابة: " .. tostring(answer)

			-- كتابة الإجابة
			equation.answerBox.Text =
				tostring(answer)

			task.wait(0.15)

			-- الضغط على زر تأكيد
			local success = pcall(function()

				equation.confirmButton:Activate()

			end)

			if success then

				status.Text = "✅ تم تأكيد الإجابة"

			else

				status.Text = "⚠️ تعذر الضغط على تأكيد"

				return false

			end

			task.wait(0.5)

			return true

		end

		task.wait(0.1)

	end

	status.Text = "⚠️ لم تظهر نافذة المعادلة"

	return false

end

-- =========================
-- الانتقال ثم الالتقاط
-- =========================

local function teleportToDrop(drop)

	if not drop or not drop.Parent then
		return
	end

	if isPlayerObject(drop) then
		return
	end

	if isVehicleOrAircraft(drop) then
		return
	end

	local root = getRoot()

	if not root then
		return
	end

	local position = drop.Position

	local targetPosition = Vector3.new(
		position.X,
		position.Y + 4,
		position.Z
	)

	root.CFrame = CFrame.new(targetPosition)

	currentDrop = drop

	print("🦊 FOX_SHOP")
	print("✅ تم اكتشاف Sky Drop")
	print("📍 X:", position.X)
	print("📍 Y:", position.Y)
	print("📍 Z:", position.Z)

	status.Text = "📍 تم الوصول إلى Drop"

	task.wait(0.25)

	if not enabled then
		return
	end

	-- =========================
	-- تفعيل ProximityPrompt
	-- =========================

	local promptWorked =
		holdDropPrompt(drop)

	if not promptWorked then

		currentDrop = nil

		return

	end

	-- =========================
	-- حل المعادلة
	-- =========================

	waitingForManualSolve = true

	solveEquation()

	-- إعطاء اللعبة وقتًا لمعالجة التأكيد
	task.wait(0.5)

	-- =========================
	-- انتظار انتهاء الـDrop
	-- =========================

	status.Text = "⏳ انتظار نتيجة الـDrop..."

	local startWait = os.clock()
	local MAX_WAIT = 60

	while enabled
		and drop.Parent
		and os.clock() - startWait < MAX_WAIT do

		local promptStillThere =
			findDropPrompt(drop)

		if not promptStillThere then
			break
		end

		task.wait(0.25)

	end

	waitingForManualSolve = false
	currentDrop = nil

	if not enabled then
		return
	end

	status.Text = "🔎 يبحث عن Drop جديد..."

end

