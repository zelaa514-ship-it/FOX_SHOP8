-- =========================
-- الحصول على اللاعب
-- =========================

local function getRoot()

	local character = player.Character

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")

end

-- =========================
-- هل الجسم تابع للاعب؟
-- =========================

local function isPlayerObject(object)

	for _, otherPlayer in ipairs(Players:GetPlayers()) do

		local character = otherPlayer.Character

		if character and object:IsDescendantOf(character) then
			return true
		end

	end

	return false

end

-- =========================
-- المركبات والطائرات
-- =========================

local function isVehicleOrAircraft(object)

	local current = object

	while current and current ~= workspace do

		if current:IsA("Model") then

			local name = string.lower(current.Name)

			local vehicleWords = {
				"car",
				"vehicle",
				"truck",
				"bus",
				"boat",
				"ship",
				"plane",
				"airplane",
				"aircraft",
				"helicopter",
				"jet",
				"jetplane",
				"drone",
				"chopper",
				"train",
				"bike",
				"motorcycle",
				"vehiclemodel"
			}

			for _, word in ipairs(vehicleWords) do

				if string.find(name, word, 1, true) then
					return true
				end

			end

			if current:FindFirstChildWhichIsA("VehicleSeat", true) then
				return true
			end

			local seat = current:FindFirstChildWhichIsA("Seat", true)

			if seat then

				local descendants = current:GetDescendants()

				if #descendants >= 4 then
					return true
				end

			end

		end

		current = current.Parent

	end

	return false

end

-- =========================
-- الأجسام الكبيرة
-- =========================

local function isLargeObject(object)

	if not object:IsA("BasePart") then
		return true
	end

	local size = object.Size

	if size.X > 20 or size.Y > 20 or size.Z > 20 then
		return true
	end

	return false

end

-- =========================
-- موديل كبير
-- =========================

local function isPartOfLargeModel(object)

	local model = object:FindFirstAncestorOfClass("Model")

	if not model then
		return false
	end

	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end

	if isVehicleOrAircraft(object) then
		return true
	end

	local parts = 0

	for _, descendant in ipairs(model:GetDescendants()) do

		if descendant:IsA("BasePart") then

			parts += 1

			if parts > 30 then
				return true
			end

		end

	end

	return false

end

-- =========================
-- تسجيل جسم جديد
-- =========================

local function registerObject(object)

	if not object:IsA("BasePart") then
		return
	end

	if not object:IsDescendantOf(workspace) then
		return
	end

	if isPlayerObject(object) then
		return
	end

	if isVehicleOrAircraft(object) then
		return
	end

	if isLargeObject(object) then
		return
	end

	if isPartOfLargeModel(object) then
		return
	end

	if object.Transparency >= 1 then
		return
	end

	if object.CanQuery == false then
		return
	end

	local root = getRoot()

	if not root then
		return
	end

	if object.Position.Y < root.Position.Y + MIN_HEIGHT then
		return
	end

	local horizontalDistance = (
		Vector3.new(object.Position.X, 0, object.Position.Z)
		-
		Vector3.new(root.Position.X, 0, root.Position.Z)
	).Magnitude

	if horizontalDistance > SCAN_DISTANCE then
		return
	end

	candidates[object] = {

		firstPosition = object.Position,
		lastPosition = object.Position,
		lastTime = os.clock(),
		highestY = object.Position.Y,
		lastFallSpeed = nil,
		spawnTime = os.clock(),
		samples = 0,
		fallSamples = 0

	}

end

-- =========================
-- مراقبة الأجسام الجديدة
-- =========================

workspace.DescendantAdded:Connect(function(object)

	if not enabled then
