-- =========================
-- المراقبة المستمرة
-- =========================

RunService.Heartbeat:Connect(function()

	if not enabled then
		return
	end

	if waitingForManualSolve then
		return
	end

	if os.clock() - lastTeleport < TELEPORT_COOLDOWN then
		return
	end

	local detectedDrop = nil

	for object, data in pairs(candidates) do

		if checkDrop(object, data) then

			detectedDrop = object

			break

		end

	end

	if detectedDrop then

		lastTeleport = os.clock()

		candidates[detectedDrop] = nil

		task.spawn(function()

			teleportToDrop(detectedDrop)
		end)

	end

end)

